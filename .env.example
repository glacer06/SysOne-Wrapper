# Copy to .env.local and fill in. Never commit a file with real values.
# The console reads these through apps/console/src/env.ts.

# TypeSafe API key for pnpm smoke and pnpm fixtures:record. Org keys live in the key vault, not here.
TYPESAFE_API_KEY=
# Postgres connection string for the console. The app role must not bypass RLS.
DATABASE_URL=
# Session signing secret for the auth library, at least 32 characters.
AUTH_SECRET=
# Key encryption key for the tenant key vault (envelope encryption, ADR-003).
SYSONE_KEK=
# ES256 private key that signs short-lived browser tokens.
SYSONE_JWT_SIGNING_KEY=
# System One transport: "fixture" (default, no network) or "sdk" (needs TYPESAFE_API_KEY).
SYSTEM_ONE_TRANSPORT=
# Stripe secret key (sk_...) for billing.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Redis URL for cache and rate limits.
REDIS_URL=
# Anthropic API key for llm-client (Studio drafting, improve mode, escalate_to_llm).
ANTHROPIC_API_KEY=
# Set to 1 to skip env validation, for example in a build that has no secrets.
SKIP_ENV_VALIDATION=

# Customer tools (sysone CLI, MCP server). They never hold a TypeSafe key.
# Agent or app token used by the sysone CLI and the MCP server.
SYSONE_TOKEN=
# Base URL of the SysOne API, for example http://localhost:3000.
SYSONE_BASE_URL=
