# Copy to .env.local and fill in. Never commit a file with real values.
# The console reads these through apps/console/src/env.ts.

# TypeSafe API key for platform key mode, pnpm smoke and pnpm fixtures:record. Org keys live in the key vault, not here.
TYPESAFE_API_KEY=
# OpenRouter API key for the OpenRouter route to System One models (ADR-011, proposed): platform key
# mode on that provider, and pnpm smoke / fixtures:record with --provider openrouter. Org keys live in
# the key vault. There is no base URL variable: provider base URLs are constants in core.
OPENROUTER_API_KEY=
# Vercel AI Gateway API key for the Vercel route to System One models (ADR-013): platform key mode on
# that provider, and pnpm smoke / fixtures:record with --provider vercel. OIDC tokens are not
# supported. Org keys live in the key vault.
AI_GATEWAY_API_KEY=
# Postgres connection string for the console. The app role must not bypass RLS.
DATABASE_URL=
# Session signing secret for the auth library, at least 32 characters. It also encrypts TOTP secrets,
# so changing it signs everyone out and resets every two-factor setup.
AUTH_SECRET=
# Console origin for sign-in (Better Auth), for example https://app.bandwise.dev or http://localhost:3000.
# Unset: the early-access page still works and sign-in is off.
BETTER_AUTH_URL=
# Optional extra gate on console sign-in: comma-separated emails. Members of the internal org only either way.
BANDWISE_CONSOLE_EMAILS=
# Key encryption key for the tenant key vault (envelope encryption, ADR-003). Optional until Phase 2
# wires the vault in; dev uses local:<base64 32 bytes>, production aws-kms:.
BANDWISE_KEK=
# ES256 private key that signs short-lived browser tokens. Optional until browser tokens ship.
BANDWISE_JWT_SIGNING_KEY=
# System One transport: "fixture" (default, no network) or "sdk" (needs TYPESAFE_API_KEY).
SYSTEM_ONE_TRANSPORT=
# Stripe secret key (sk_...) for billing.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Redis URL for cache and rate limits.
REDIS_URL=
# Anthropic API key for llm-client (Studio drafting, improve mode, escalate_to_llm).
ANTHROPIC_API_KEY=
# Set to 1 to skip env validation, for example in a build that has no secrets.
SKIP_ENV_VALIDATION=

# Customer tools (bandwise CLI, MCP server). They never hold a TypeSafe, OpenRouter or AI Gateway key.
# Agent or app token used by the bandwise CLI and the MCP server.
BANDWISE_TOKEN=
# Base URL of the Bandwise API, for example http://localhost:3000.
BANDWISE_BASE_URL=
