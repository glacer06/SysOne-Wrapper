{
  "name": "@bandwise/console",
  "version": "0.0.0",
  "private": true,
  "description": "Tenant console, platform admin and /api/v1. The only place with DB and TypeSafe keys.",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "mint-token": "tsx --conditions=@bandwise/source scripts/mint-token.ts",
    "bootstrap-internal": "tsx --conditions=@bandwise/source scripts/bootstrap-internal.ts"
  },
  "dependencies": {
    "@bandwise/billing": "workspace:*",
    "@bandwise/core": "workspace:*",
    "@bandwise/db": "workspace:*",
    "@bandwise/llm-client": "workspace:*",
    "@bandwise/system-one-client": "workspace:*",
    "@bandwise/tenancy": "workspace:*",
    "@t3-oss/env-nextjs": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@bandwise/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
