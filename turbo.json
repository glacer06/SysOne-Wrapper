{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "pnpm-workspace.yaml"
  ],
  "tasks": {
    "transit": {
      "dependsOn": [
        "^transit"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "transit"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "transit"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "transit"
      ],
      "outputs": []
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "@sysone/config#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@sysone/config#test": {
      "dependsOn": [
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/react/src/__fixtures__/**",
        "$TURBO_ROOT$/packages/cli/src/local/__fixtures__/**"
      ],
      "outputs": []
    },
    "@sysone/core#test": {
      "dependsOn": [
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.claude/skills/sysone-builder/templates/**",
        "$TURBO_ROOT$/.claude/skills/sysone-builder/references/**"
      ],
      "outputs": []
    },
    "@sysone/console#test": {
      "dependsOn": [
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.claude/skills/sysone-builder/templates/**",
        "$TURBO_ROOT$/packages/core/openapi.json"
      ],
      "outputs": []
    },
    "@sysone/docs#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/core/openapi.json"
      ],
      "env": [
        "NEXT_PUBLIC_DOCS_URL"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "@sysone/docs#test": {
      "dependsOn": [
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/core/openapi.json"
      ],
      "outputs": []
    },
    "@sysone/evals#test": {
      "dependsOn": [
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/system-one-client/fixtures/**"
      ],
      "outputs": []
    },
    "@sysone/cli#test": {
      "dependsOn": [
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.claude/skills/sysone-builder/templates/**",
        "$TURBO_ROOT$/packages/system-one-client/fixtures/**"
      ],
      "outputs": []
    }
  }
}
