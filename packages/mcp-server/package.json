{
  "name": "@bandwise/mcp-server",
  "version": "0.0.0",
  "private": true,
  "description": "Bandwise Gate over MCP (ADR-021): stateless streamable HTTP, six preset tools. Phase 7 brings the full list.",
  "type": "module",
  "exports": {
    ".": {
      "@bandwise/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
