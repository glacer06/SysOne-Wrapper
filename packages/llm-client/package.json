{
  "name": "@sysone/llm-client",
  "version": "0.0.0",
  "private": true,
  "description": "LlmTransport implementations: Anthropic (default), an optional OpenRouter chat route (ADR-011), and a fixture transport. The only importer of @anthropic-ai/sdk.",
  "type": "module",
  "exports": {
    ".": {
      "@sysone/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixture": {
      "@sysone/source": "./src/fixture/index.ts",
      "types": "./dist/fixture/index.d.ts",
      "import": "./dist/fixture/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@sysone/core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sysone/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
