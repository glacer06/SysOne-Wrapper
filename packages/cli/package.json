{
  "name": "@bandwise/cli",
  "version": "0.0.0",
  "private": true,
  "description": "@bandwise/cli (bin bandwise): management commands over /api/v1 (Phase 3), --local fixture mode, and live mode with your own key (ADR-020).",
  "type": "module",
  "bin": {
    "bandwise": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "@bandwise/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@bandwise/core": "workspace:*",
    "@bandwise/system-one-client": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@bandwise/core": {
      "optional": true
    },
    "@bandwise/system-one-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bandwise/config": "workspace:*",
    "@bandwise/core": "workspace:*",
    "@bandwise/system-one-client": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
