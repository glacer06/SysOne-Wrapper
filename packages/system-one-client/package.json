{
  "name": "@bandwise/system-one-client",
  "version": "0.0.0",
  "private": true,
  "description": "SystemOneTransport implementations. The only importer of @typesafe-ai/sdk.",
  "type": "module",
  "exports": {
    ".": {
      "@bandwise/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixture": {
      "@bandwise/source": "./src/fixture/index.ts",
      "types": "./dist/fixture/index.d.ts",
      "import": "./dist/fixture/index.js"
    },
    "./server": {
      "@bandwise/source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "fixtures",
    "contract"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bandwise/core": "workspace:*",
    "@typesafe-ai/sdk": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@bandwise/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
