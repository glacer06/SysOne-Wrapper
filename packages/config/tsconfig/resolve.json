{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Import resolution map for ESLint boundary rules only. Not used to compile code.",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "customConditions": [
      "@bandwise/source"
    ],
    "allowJs": true,
    "noEmit": true,
    "paths": {
      "@bandwise/core/contracts": [
        "../../core/src/contracts/index.ts"
      ],
      "@bandwise/core/openapi.json": [
        "../../core/openapi.json"
      ],
      "@bandwise/client/server": [
        "../../client/src/server/index.ts"
      ],
      "@bandwise/system-one-client/fixture": [
        "../../system-one-client/src/fixture/index.ts"
      ],
      "@bandwise/llm-client/fixture": [
        "../../llm-client/src/fixture/index.ts"
      ],
      "@bandwise/*": [
        "../../*/src/index.ts",
        "../../*/src/index.tsx"
      ]
    }
  },
  "files": []
}
