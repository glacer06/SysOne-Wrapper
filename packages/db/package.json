{
  "name": "@sysone/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema, RLS policies, migrations, withTenant(), repositories. The only importer of drizzle-orm.",
  "type": "module",
  "exports": {
    ".": {
      "@sysone/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "NODE_OPTIONS=--conditions=@sysone/source drizzle-kit generate",
    "db:migrate": "tsx --conditions=@sysone/source scripts/migrate.ts",
    "db:seed": "tsx --conditions=@sysone/source scripts/seed.ts",
    "rls:sql": "tsx --conditions=@sysone/source scripts/print-security-block.ts"
  },
  "dependencies": {
    "@sysone/core": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@sysone/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
