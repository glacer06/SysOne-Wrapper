{
  "name": "@bandwise/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema, RLS policies, migrations, withTenant(), repositories. The only importer of drizzle-orm.",
  "type": "module",
  "exports": {
    ".": {
      "@bandwise/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./migrate": {
      "@bandwise/source": "./src/migrate.ts",
      "types": "./dist/migrate.d.ts",
      "import": "./dist/migrate.js"
    },
    "./testing": {
      "@bandwise/source": "./src/testing/harness.ts"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "NODE_OPTIONS=--conditions=@bandwise/source drizzle-kit generate",
    "db:migrate": "tsx --conditions=@bandwise/source scripts/migrate.ts",
    "db:seed": "tsx --conditions=@bandwise/source scripts/seed.ts",
    "rls:sql": "tsx --conditions=@bandwise/source scripts/print-security-block.ts"
  },
  "dependencies": {
    "@bandwise/core": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@bandwise/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
